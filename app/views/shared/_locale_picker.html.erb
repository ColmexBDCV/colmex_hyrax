    <%= javascript_tag "var current_locale = '#{I18n.locale.to_s}';" %>
    <script type="text/javascript">
        window.Locale = current_locale
    </script>
<li class="nav-item dropdown">
     <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false" aria-controls="language-dropdown-menu">
        <b class="fa fa-globe " id="world"></b>
        <span class="sr-only"><%= t('hyrax.toolbar.language_switch') %></span>
        <span title="<%= t('hyrax.toolbar.language_switch') %>"> <%= t('hyrax.toolbar.language_code') %></span>
        <b class="caret"></b>
    </a>
    <ul id="language-dropdown-menu" class="dropdown-menu" role="menu">
        <li role="presentation" class="dropdown-header"><%= t('hyrax.toolbar.language_switch') %></li>
        <li role="presentation" class="divider"></li>
        <% available_translations.each do |language, label| %>
            <li role="presentation" lang="<%= language %>">
                <% locale_url = "#{request.path}?#{request.query_parameters.merge(locale: language.to_s).to_query}" %>
                <%= link_to label, locale_url, class: 'dropdown-item', role: 'menuitem', tabindex: '-1', data: { locale: language } %>
            </li>
        <% end %>
    </ul>
</li>
